# Copy to .env and fill in. .env is git-ignored.
# Your relay URL from `npx wrangler deploy`
FIGMA_BRIDGE_URL=https://figma-bridge.<your-subdomain>.workers.dev
# Your channel token (random, 24+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
FIGMA_BRIDGE_TOKEN=replace-with-your-channel-token
